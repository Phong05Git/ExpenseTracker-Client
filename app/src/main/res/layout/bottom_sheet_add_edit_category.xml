<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/light_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCategorySheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thêm danh mục"
            android:textColor="@color/light_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/buttonCloseCategorySheet"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng"
            android:src="@drawable/ic_close"
            app:tint="@color/light_text_secondary" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Tên danh mục">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCategoryName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:textColor="@color/light_text_primary"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Loại danh mục"
        android:textColor="@color/light_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/categoryTypeContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_transaction_type_container"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCategoryExpense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_transaction_type_expense_selected"
            android:text="Chi tiêu"
            android:textColor="@color/expense_red"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCategoryIncome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_transaction_type_unselected"
            android:text="Thu nhập"
            android:textColor="@color/light_text_secondary"
            android:textSize="14sp"
            app:backgroundTint="@null"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Biểu tượng"
        android:textColor="@color/light_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/rowCategoryIcon"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCategoryIconPreview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_transaction_icon"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Biểu tượng"
            android:textColor="@color/light_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCategoryIconName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn biểu tượng"
            android:textColor="@color/light_text_secondary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/light_text_secondary" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowCategoryColor"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewCategoryColorPreview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_transaction_icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Màu sắc"
            android:textColor="@color/light_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCategoryColorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn màu"
            android:textColor="@color/light_text_secondary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/light_text_secondary" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSaveCategory"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Lưu"
        android:textColor="@color/light_surface"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_green"
        app:cornerRadius="12dp" />

</LinearLayout>