<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background">

    <!-- Top bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/light_surface"
        android:elevation="3dp"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ExpenseTracker"
            android:textColor="@color/light_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iconNotification"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/iconNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Thông báo"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_notification"
            app:tint="@color/light_text_primary"
            app:layout_constraintEnd_toStartOf="@id/iconAccount"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/iconAccount"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tài khoản"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            app:tint="@color/light_text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fragment container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/light_surface"
        android:elevation="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Overview -->
        <LinearLayout
            android:id="@+id/navOverview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navFinance"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/iconOverview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Tổng quan"
                android:src="@drawable/ic_home"
                app:tint="@color/primary_green" />

            <TextView
                android:id="@+id/labelOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tổng quan"
                android:textColor="@color/primary_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Finance -->
        <LinearLayout
            android:id="@+id/navFinance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toEndOf="@id/navOverview"
            app:layout_constraintEnd_toStartOf="@id/fabContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/iconFinance"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Tài chính"
                android:src="@drawable/ic_wallet"
                app:tint="@color/light_text_secondary" />

            <TextView
                android:id="@+id/labelFinance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tài chính"
                android:textColor="@color/light_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Center action -->
        <FrameLayout
            android:id="@+id/fabContainer"
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintStart_toEndOf="@id/navFinance"
            app:layout_constraintEnd_toStartOf="@id/navGroups"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAdd"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="Thêm giao dịch"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/primary_green"
                app:elevation="6dp"
                app:maxImageSize="24dp"
                app:tint="@android:color/white" />
        </FrameLayout>

        <!-- Groups -->
        <LinearLayout
            android:id="@+id/navGroups"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toEndOf="@id/fabContainer"
            app:layout_constraintEnd_toStartOf="@id/navChatbot"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/iconGroups"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Nhóm"
                android:src="@drawable/ic_person"
                app:tint="@color/light_text_secondary" />

            <TextView
                android:id="@+id/labelGroups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Nhóm"
                android:textColor="@color/light_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Chatbot -->
        <LinearLayout
            android:id="@+id/navChatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toEndOf="@id/navGroups"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/iconChatbot"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Chatbot"
                android:src="@drawable/ic_lightbulb"
                app:tint="@color/light_text_secondary" />

            <TextView
                android:id="@+id/labelChatbot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Chatbot"
                android:textColor="@color/light_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
